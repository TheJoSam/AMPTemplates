App.ExecutableLinux=serverfiles/Server
App.LinuxCommandLineArgs=
App.Ports=@IncludeJson[super-mario-odyssey-onlineports.json]
App.UpdateSources=@IncludeJson[super-mario-odyssey-onlineupdates.json]
